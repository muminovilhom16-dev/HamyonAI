{
  "name": "@hamyon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/server.js",
    "set-webhook": "tsx src/scripts/set-webhook.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "migrate": "node dist/migrate.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@hamyon/ai": "workspace:^",
    "@hamyon/config": "workspace:*",
    "@hamyon/core": "workspace:*",
    "@hamyon/db": "workspace:*",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
