# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://hamyon:hamyon@localhost:5432/hamyon
TEST_DATABASE_URL=postgres://hamyon:hamyon@localhost:5432/hamyon_test
# REDIS_URL=redis://localhost:6379   # queue, Phase 4+

# From @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 32+ chars of A-Z a-z 0-9 _ -   e.g. `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# TELEGRAM_API_ROOT=            # only for a self-hosted Bot API server

# Public https URL of this API (webhook + /web login links) and of the web panel
PUBLIC_BASE_URL=
# Web panel is served by the API (same origin): usually WEB_BASE_URL = PUBLIC_BASE_URL + "/"
WEB_BASE_URL=
WEB_STATIC_DIR=apps/web/dist
CORS_ORIGINS=

# 32+ random chars, pepper for hashing login/session tokens: `openssl rand -hex 32`
AUTH_TOKEN_SECRET=
WEB_LOGIN_TOKEN_TTL_MINUTES=15
WEB_SESSION_TTL_DAYS=30
TRUST_PROXY=false

DEFAULT_CURRENCY=UZS
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_REMINDER_TIME=21:00
MAX_PROACTIVE_MESSAGES_PER_DAY=2

AI_PROVIDER=anthropic
AI_TEXT_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
AI_CONFIDENCE_THRESHOLD=0.8
AI_TIMEOUT_MS=8000

# Speech-to-text (voice messages). Google Cloud API key restricted to the Speech-to-Text API.
STT_PROVIDER=google
GOOGLE_STT_API_KEY=
GOOGLE_STT_MODEL=default
GOOGLE_STT_API_VERSION=v1p1beta1
GOOGLE_STT_USD_PER_MINUTE=0.024
VOICE_MAX_SECONDS=60

# Optional JSON override of plan limits (see packages/config/src/plans.ts)
# PLAN_LIMITS_JSON=
